# Copy to .env.deploy; generate independent random values for every secret.
# Use a long alphanumeric PostgreSQL password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex
PUBLIC_URL=https://clearhold.example.com
SITE_ADDRESS=clearhold.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
NEXTAUTH_SECRET=replace-with-random-secret-at-least-32-characters
MASTER_KEY=replace-with-exactly-64-hex-characters
IDEMPOTENCY_HASH_KEY=replace-with-a-different-64-hex-character-key
SCHEDULER_SECRET=replace-with-another-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
