{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/authorization-policy.test.js .test-dist/crypto.test.js .test-dist/escrow-state-policy.test.js .test-dist/idempotency-policy.test.js .test-dist/legacy-boundary.test.js .test-dist/ledger-policy.test.js .test-dist/login-rate-limit.test.js .test-dist/registration.test.js",
    "test:db:ledger": "tsc -p tsconfig.ledger-integration.json && node --test .ledger-test-dist/tests/ledger-postgres.test.js",
    "test:db:state": "tsc -p tsconfig.state-integration.json && node --test .state-test-dist/tests/escrow-state-machine-postgres.test.js",
    "test:db:idempotency": "tsc -p tsconfig.idempotency-integration.json && node --test .idempotency-test-dist/tests/idempotency-postgres.test.js",
    "test:db:reconciliation": "tsc -p tsconfig.reconciliation-integration.json && node --test .reconciliation-test-dist/tests/reconciliation-postgres.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "inngest": "4.24.0",
    "ioredis": "^6.0.0",
    "next": "15.5.27",
    "next-auth": "^4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/json5": "^0.0.29",
    "@types/node": "^22.20.2",
    "eslint": "^8.44.0",
    "eslint-config-next": "15.5.27",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
