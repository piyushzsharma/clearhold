{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "incremental": false,
    "rootDir": ".",
    "outDir": ".idempotency-test-dist",
    "types": ["node"]
  },
  "include": [
    "src/lib/idempotency.ts",
    "src/lib/idempotency-policy.ts",
    "tests/idempotency-postgres.test.ts"
  ]
}
