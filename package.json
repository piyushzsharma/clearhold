{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "clearhold",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "dev": "turbo run dev",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "verify": "npm run db:validate && npm run lint && npm run type-check && npm run test && npm run build",
    "clean": "turbo run clean",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:validate": "npm run db:validate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "devDependencies": {
    "@types/json5": "^0.0.30",
    "@types/node": "^22.20.2",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
