# Copy the relevant values into apps/backend/.env and apps/frontend/.env.local.
# This root file documents the complete local configuration contract.

# PostgreSQL and Redis
DATABASE_URL="postgresql://clearhold:clearhold@localhost:5432/clearhold"
REDIS_URL="redis://localhost:6379"

# Public application URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3001"

# Generate local secrets; never reuse these placeholders in a deployment.
NEXTAUTH_SECRET="replace-with-a-random-secret"
MASTER_KEY="replace-with-64-hex-characters"
IDEMPOTENCY_HASH_KEY="replace-with-a-different-64-hex-character-secret"
SCHEDULER_SECRET="replace-with-an-independent-random-secret-at-least-32-characters"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Inngest: omit cloud keys only when using the local dev server.
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Rate-limit values are counts and seconds.
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900"
NODE_ENV="development"
